# Public HTTPS origin, without /mcp. Set this after assigning your Railway domain.
BRIDGE_PUBLIC_URL=https://YOUR-DOMAIN
GOOGLE_OAUTH_CLIENT_ID=YOUR-GOOGLE-OAUTH-WEB-CLIENT-ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR-GOOGLE-OAUTH-CLIENT-SECRET
# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep stable across deploys. Rotation invalidates sessions and encrypted job records.
BRIDGE_SIGNING_KEY=REPLACE-WITH-A-LONG-RANDOM-SECRET
BRIDGE_ALLOWED_EMAILS=you@example.com
BRIDGE_ADMIN_EMAILS=you@example.com
# Optional stable Google subject IDs, comma separated.
BRIDGE_ALLOWED_SUBJECTS=
# In Railway use the variable reference ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379
# Paste the complete service-account JSON into a sealed Railway variable.
GOOGLE_PLAY_STORE_CREDENTIALS=
BRIDGE_DATA_DIR=/data
PLAY_STORE_MCP_READ_ONLY=0
BRIDGE_CODE_MODE=1
# Defaults: 8 GiB/file, 8 MiB/chunk, 32 GiB total reserved file storage.
BRIDGE_MAX_FILE_BYTES=8589934592
BRIDGE_MAX_CHUNK_BYTES=8388608
BRIDGE_MAX_STORAGE_BYTES=34359738368
BRIDGE_MAX_PENDING_JOBS=100
BRIDGE_DOWNLOAD_TTL=900
PLAY_STORE_MCP_LOG_LEVEL=INFO
